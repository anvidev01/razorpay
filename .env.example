# Copy to .env and fill in. .env is gitignored and never committed.
#   cp .env.example .env && $EDITOR .env
#
# Razorpay test mode — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Test keys always start with rzp_test_. Never put a live key (rzp_live_) here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: lets the natural-language step use Claude instead of the offline matcher.
# ANTHROPIC_API_KEY=sk-ant-...
